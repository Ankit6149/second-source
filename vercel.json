{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "integrate/product-completion-20261030": false
    }
  },
  "buildCommand": "python3 web/build.py --with-app",
  "outputDirectory": "web/dist",
  "installCommand": "npm ci --prefix product --no-audit --no-fund",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
